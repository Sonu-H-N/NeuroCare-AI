# Copy this file to .env and fill in your values. Never commit the real .env.

# Required for AI features (chatbot, AI summary, staging, science, recommendations)
ANTHROPIC_API_KEY=sk-ant-api03-your-key-here

# Optional overrides
ANTHROPIC_MODEL=claude-sonnet-4-6
ANTHROPIC_MAX_TOKENS=1000
PORT=3000

# Optional: require this value in the "x-app-key" header to use /api/claude.
# Leave blank while developing locally. Set it before deploying anywhere
# public so strangers can't spend your Anthropic credits.
APP_ACCESS_CODE=

# Optional: comma-separated origins allowed to call the API cross-origin
# (only needed if you serve the frontend from somewhere other than this
# server, e.g. a separate static host).
ALLOWED_ORIGINS=
